---
import { getConfig, getDefaultLocale } from "../lib/config";
import { buildStaticPaths, type StaticPath } from "../lib/static-paths";
import { routeMeta } from "../lib/route-meta";
import type { Navigation } from "../lib/site-config-types";

type Props = StaticPath["props"];

export function getStaticPaths() {
  return buildStaticPaths(getConfig(), getDefaultLocale());
}

const props = Astro.props;
const { locale } = props;
const config = getConfig();
const layoutFilePath = props.kind === "post" ? props.post.layoutFilePath : props.page.layout?.filePath ?? null;
const content = props.kind === "page" ? props.content : Object.fromEntries(
  Object.entries(config.layouts.find((layout) => layout.filePath === layoutFilePath)?.detectedKeys ?? {})
    .map(([key, value]) => [key, value.initial])
);
const blogLists = props.kind === "page" ? props.blogLists : {};

// Dynamic layout import
const layoutModules = import.meta.glob("../layouts/**/*.tsx", { eager: true }) as Record<
  string,
  { default: React.ComponentType<Record<string, unknown>> }
>;

let LayoutComponent: React.ComponentType<Record<string, unknown>> | null = null;
if (layoutFilePath) {
  const fileName = layoutFilePath.split("/").pop();
  const matchingEntry = Object.entries(layoutModules).find(([key]) =>
    key.endsWith(`/${fileName}`)
  );
  if (matchingEntry) {
    LayoutComponent = matchingEntry[1].default;
  }
}

const favicon = content["_meta.favicon"];
const base = (config.settings?.siteUrl ?? "").replace(/\/+$/, "");
const siteName = config.settings?.name ?? "";
const { metaTitle, metaDescription, ogImage, canonical } = routeMeta(props, {
  base, siteName, defaultLocale: getDefaultLocale(), pathname: Astro.url.pathname,
});

const isHomepage = props.kind === "page" && props.pageNumber === 1 && props.page.path.replace(/^\//, "") === "";
const organizationJsonLd =
  isHomepage && siteName && base
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: siteName,
        url: base + "/",
      })
    : "";

const filteredNavigation = config.navigation.filter((n: Navigation) => n.locale === locale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    {config.buildTarget === "staging" && <meta name="robots" content="noindex" />}
    {metaDescription && <meta name="description" content={metaDescription} />}
    {favicon && <link rel="shortcut icon" href={favicon} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {siteName && <meta property="og:site_name" content={siteName} />}
    {metaTitle && <meta property="og:title" content={metaTitle} />}
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {metaTitle && <meta name="twitter:title" content={metaTitle} />}
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    {ogImage ? (
      <>
        <meta property="og:image" content={ogImage} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    ) : (
      <meta name="twitter:card" content="summary" />
    )}
    {organizationJsonLd && (
      <script type="application/ld+json" is:inline set:html={organizationJsonLd} />
    )}
  </head>
  <body>
    {LayoutComponent ? (
      <LayoutComponent
        {...(props.kind === "post" ? { post: props.post } : {})}
        content={content}
        blogLists={blogLists}
        navigation={filteredNavigation}
        locale={locale}
        locales={config.locales}
        settings={config.settings}
      />
    ) : (
      <div>
        <p>Layout not found{layoutFilePath ? `: ${layoutFilePath}` : " (no layout assigned)"}</p>
      </div>
    )}
  </body>
</html>
